# Copy this file to .env and fill in real values. Never commit .env.

# --- Provider API keys (free tier) ---
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
# Groq: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# --- Model names ---
# Free-tier model availability changes over time. If a provider returns
# "model not found" / deprecation errors, update these values — no code change needed.
# Gemini models: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite
# Groq models: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b
# Only for reasoning models (e.g. gpt-oss): low | medium | high.
# Lower effort leaves more of the token budget for the JSON answer.
# Leave empty for non-reasoning models — they reject this parameter.
GROQ_REASONING_EFFORT=low

# --- Provider call settings ---
PROVIDER_TIMEOUT_SECONDS=30

# --- Client-side rate limits (requests per minute) ---
# Set these at or below your account's free-tier limits for the chosen models:
# Gemini: https://aistudio.google.com/rate-limit  (per model; not listed in public docs)
# Groq:   https://console.groq.com/settings/limits (free plan was 30 RPM for gpt-oss-20b)
GEMINI_RPM=10
GROQ_RPM=30

# --- Database ---
# docker-compose uses these for the db service and builds the API's
# DATABASE_URL from them, so the credentials are defined only here.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=content_generator
# Only needed when running the API outside docker-compose:
# DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/content_generator
