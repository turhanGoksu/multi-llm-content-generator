# Copy this file to .env and fill in real values. Never commit .env.

# --- Provider API keys (free tier) ---
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
# Groq: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# --- Model names ---
# Free-tier model availability changes over time. If a provider returns
# "model not found" / deprecation errors, update these values — no code change needed.
# Gemini models: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite
# Groq models: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b

# --- Provider call settings ---
PROVIDER_TIMEOUT_SECONDS=30

# --- Database ---
# Inside docker-compose the host is the service name "db", not localhost.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/content_generator
